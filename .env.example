# Скопируйте в .env и заполните. Файл .env не публикуйте и не отправляйте в чат.

# Порт веб-панели
PORT=3000
# Через сколько часов неодобренный отзыв считается просроченным
SLA_HOURS=24

# Claude API (черновики ответов и месячные сводки). Ключ: https://console.anthropic.com/
# Без ключа приложение работает в упрощённом режиме (оценка по звёздам и шаблонные ответы).
ANTHROPIC_API_KEY=
# Модель можно поменять, например на claude-sonnet-5-5 (дешевле)
ANTHROPIC_MODEL=claude-opus-5-5

# Парсер Яндекс и Google Карт (ссылки задаются в карточке клиента)
# Как часто загружать новые отзывы автоматически, часов (0 — только вручную)
PARSER_INTERVAL_HOURS=6
# Сколько последних отзывов брать с каждой площадки за один прогон
PARSER_MAX_REVIEWS=200
# 1 — показывать окно браузера (например, чтобы самому пройти проверку «я не робот»)
PARSER_SHOW_BROWSER=
# Путь к Chrome или Edge, если не нашёлся автоматически
CHROME_PATH=

# Google Business Profile API (отзывы по вашим карточкам в Google Картах)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Telegram-бот: дневная статистика по отзывам администратору (инструкция в README)
# Токен выдаёт @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш Telegram id (узнать: написать боту /id). Несколько через запятую
TELEGRAM_ADMIN_ID=
# Во сколько присылать статистику, по времени сервера
TELEGRAM_DAILY_TIME=20:00
# Голосовые сообщения боту → текст (Yandex SpeechKit). API-ключ сервисного аккаунта с ролью ai.speechkit-stt.user
YANDEX_SPEECHKIT_API_KEY=
# Нужен, только если ключ не от сервисного аккаунта
YANDEX_FOLDER_ID=
# Если Telegram заблокирован у провайдера: HTTP-прокси вашего VPN-клиента, например http://127.0.0.1:10809
TELEGRAM_PROXY=
